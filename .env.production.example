# MoveOS production environment — copy to .env.production and fill in.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ── Public URL (used to bake frontend builds + CORS) ─────────────────────────
# No trailing slash. e.g. https://app.pahadirides.in
PUBLIC_URL=
CORS_ORIGINS=${PUBLIC_URL}

# ── Database & cache ─────────────────────────────────────────────────────────
POSTGRES_USER=moveos
POSTGRES_PASSWORD=
POSTGRES_DB=moveos

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Payments (Razorpay collections — REQUIRED) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PLATFORM_COMMISSION_PERCENT=10

# ── Maps (Ola Maps — REQUIRED) ───────────────────────────────────────────────
OLA_MAPS_API_KEY=

# ── SMS / OTP (MSG91 — REQUIRED for launch; SMS_PROVIDER=dev refuses to boot) ─
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_TEMPLATE_ID=
MSG91_SENDER_ID=PAHADI

# ── Push notifications (Firebase FCM — optional; dev = log only) ─────────────
PUSH_PROVIDER=dev
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the service-account private key with \n escapes
FCM_PRIVATE_KEY=
# Web-push client config (Firebase console > Project settings)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# ── KYC verification (HyperVerge — optional; dev auto-verifies) ──────────────
KYC_PROVIDER=dev
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=

# ── Driver payouts (RazorpayX — optional; dev simulates) ─────────────────────
PAYOUT_PROVIDER=dev
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ── Tuning (sensible defaults) ───────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_OTP_PER_MINUTE=10
CANCELLATION_FREE_HOURS=12
CANCELLATION_PARTIAL_HOURS=2
CANCELLATION_PARTIAL_PERCENT=50
CLUSTER_INTERVAL_MINUTES=30
CLUSTER_EPS_KM=15
CLUSTER_MIN_PASSENGERS=3

# Staging escape hatch only — never in real production
# ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true
