PORT=3000
NODE_ENV=development

# Required for Prisma CLI and shared across services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moveos
REDIS_URL=redis://localhost:6379

# JWT secret — must be a cryptographically strong random value in every environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The service will refuse to start in production if this is a known-insecure default.
JWT_SECRET=replace-with-secure-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Service URLs for API Gateway (optional overrides)
DRIVER_SERVICE_URL=http://localhost:3001/api
RIDE_SERVICE_URL=http://localhost:3002/api
DISPATCH_SERVICE_URL=http://localhost:3003/api
TELEMETRY_SERVICE_URL=http://localhost:3004/api
NOTIFICATION_SERVICE_URL=http://localhost:3005/api
ONBOARDING_SERVICE_URL=http://localhost:3006/api
LOCATION_SERVICE_URL=http://localhost:3007/api
SCHEDULING_SERVICE_URL=http://localhost:3008/api
BOOKING_SERVICE_URL=http://localhost:3009/api

# Ola Maps integration
OLA_MAPS_API_KEY=your_ola_maps_api_key
OLA_MAPS_BASE_URL=https://api.olamaps.io
LOCATION_CACHE_TTL_SECONDS=300

# ──────────────────────────────────────────────────────────────────────────────
# External provider selection (libs/common/src/providers)
# Each defaults to 'dev' (logs instead of calling the real service, and OTP
# codes are echoed back as devOtpCode). Switch to the real provider + fill in
# its credentials to go live. In production, SMS_PROVIDER=dev refuses to boot
# unless ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true.
# ──────────────────────────────────────────────────────────────────────────────

# SMS / OTP delivery — dev | msg91
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_FLOW_TEMPLATE_ID=
MSG91_SENDER_ID=PAHADI

# Push notifications — dev | fcm (Firebase service-account credentials)
PUSH_PROVIDER=dev
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# KYC verification — dev | hyperverge
# Dev fixtures: ids ending 0000 => FAILED, ids ending 9999 => NEEDS_REVIEW,
# Aadhaar OTP is always 123456.
KYC_PROVIDER=dev
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1
KYC_FACE_MATCH_THRESHOLD=75

# Driver payouts — dev | razorpayx
PAYOUT_PROVIDER=dev
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Escape hatch for staging smoke tests only — never in real production
# ALLOW_DEV_PROVIDERS_IN_PRODUCTION=true
