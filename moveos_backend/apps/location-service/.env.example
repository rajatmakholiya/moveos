# ── Location Service — environment template ──────────────────────────────────
# Copy this file to .env and fill in local/development values.
# Do not commit real provider keys or production credentials.

PORT=3007
NODE_ENV=development

# Required by shared MoveOS env validation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moveos
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-secure-secret
JWT_EXPIRES_IN=1d

# Ola Maps integration. Replace with a local development key.
OLA_MAPS_API_KEY=your_ola_maps_api_key
OLA_MAPS_BASE_URL=https://api.olamaps.io

# Set to 0 to disable location API response caching.
LOCATION_CACHE_TTL_SECONDS=300
