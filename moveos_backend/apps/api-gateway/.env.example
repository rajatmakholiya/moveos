# ── API Gateway — environment template ───────────────────────────────────────
# Copy this file to .env and fill in the values.
# In production, ALL *_SERVICE_URL vars are required; the gateway will refuse
# to start if any are missing or malformed.

PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# The gateway splits this value on commas and trims whitespace; no trailing
# slash on each origin. In production, set to the exact deployed domain(s)
# only — do not use a wildcard.
#
# Intended local port assignments:
#   :3000  — API gateway (this service)
#   :3001  — moveos-admin Next.js dev server (auto-selected when :3000 is taken)
#   :3010  — moveos-pwa Next.js dev server  (configured via `next dev -p 3010`)
#   :3020  — moveos-admin alternate / staging preview
#   :3030  — legacy / Storybook dev
#   :3032  — moveos-admin alternate dev server
#   :4000  — moveos progress tracker
#   :5173  — Vite dev server (component playground)
#   :8080  — generic local reverse proxy / Docker
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3010,http://localhost:3011,http://localhost:3020,http://localhost:3030,http://localhost:3031,http://localhost:3032,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3010,http://127.0.0.1:3032,http://127.0.0.1:4000,http://localhost:5173,http://localhost:8080

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moveos

# Redis connection string (used for caching and session state).
REDIS_URL=redis://localhost:6379

# JWT secret — must be a cryptographically strong random value in every environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The service will refuse to start in production if this is a known-insecure default.
JWT_SECRET=replace-with-secure-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ── Downstream service URLs ───────────────────────────────────────────────────
# Convention: each URL *includes* the /api path segment.
# Local port assignments:
#   driver-service      → :3001
#   ride-service        → :3002
#   dispatch-service    → :3003
#   telemetry-service   → :3004
#   notification-service→ :3005
#   onboarding-service  → :3006
#   location-service    → :3007
#   scheduling-service  → :3008
#   booking-service     → :3009
DRIVER_SERVICE_URL=http://localhost:3001/api
RIDE_SERVICE_URL=http://localhost:3002/api
DISPATCH_SERVICE_URL=http://localhost:3003/api
TELEMETRY_SERVICE_URL=http://localhost:3004/api
NOTIFICATION_SERVICE_URL=http://localhost:3005/api
ONBOARDING_SERVICE_URL=http://localhost:3006/api
LOCATION_SERVICE_URL=http://localhost:3007/api
SCHEDULING_SERVICE_URL=http://localhost:3008/api
BOOKING_SERVICE_URL=http://localhost:3009/api

# Base URL of the PWA (driver-facing app), used to build driver invitation links.
# In production, set this to the deployed PWA domain (no trailing slash).
# Local default: http://localhost:3010
PWA_BASE_URL=http://localhost:3010
