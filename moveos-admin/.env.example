# Base URL of the MoveOS API gateway — must include the /api path segment.
#
# IMPORTANT: This app is built as a Next.js static export (output: 'export').
# NEXT_PUBLIC_API_URL is baked into the JavaScript bundle at build time by
# Next.js, not resolved at runtime. If you change this value you must rebuild
# the app (npm run build) and redeploy the generated `out/` directory.
#
# Development (gateway on localhost):
NEXT_PUBLIC_API_URL=http://localhost:3000/api
#
# URL of the PWA app — used for generating invite links shared with drivers.
NEXT_PUBLIC_PWA_URL=http://localhost:3010
#
# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com/api
# NEXT_PUBLIC_PWA_URL=https://app.example.com
#
# Do not add secrets here. This file is committed to version control as a
# template; copy it to .env.local and fill in your values.
