# Base URL of the MoveOS API gateway — must include the /api path segment.
# In development, the gateway runs on port 3000 by default.
# In production, set this to your deployed gateway URL (e.g. https://api.example.com/api).
# API calls in the PWA use clean paths (e.g. /bookings, /routes) — do NOT add /api
# prefixes in call sites; the base URL here already includes it.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Razorpay publishable key — required for UPI payments.
# Get it from Razorpay dashboard > Settings > API Keys (use the test key for dev).
# If this is not set, UPI checkout is blocked: dev shows a config error,
# production shows "Payment service is temporarily unavailable."
# Never set this to a secret/private key — only the publishable key_id goes here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
